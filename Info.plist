<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>SSH</string>
    <key>CFBundleDisplayName</key>
    <string>SSH</string>
    <key>CFBundleIdentifier</key>
    <string>com.yourname.stadiums-self-hosted</string>
    <key>CFBundleExecutable</key>
    <string>SSH</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.2</string>
    <key>CFBundleVersion</key>
    <string>2</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.2</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Shown in the one-time system audio-capture permission prompt. -->
    <key>NSAudioCaptureUsageDescription</key>
    <string>SSH captures audio from the app you choose so it can add live reverb.</string>
    <!-- Fallback only: SSH never records the mic, but some headsets (AirPods)
         expose a mic on the same device. If macOS counts that as mic use and this key
         is missing, it can terminate the app instead of asking. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>SSH doesn't record your microphone. macOS asks because your headphones' mic is part of the same audio device.</string>
</dict>
</plist>
