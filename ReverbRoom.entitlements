<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime blocks audio input unless this is set. Reverb Room never
         records the mic, but AirPods and some headsets put a mic on the same device
         as the speakers. Mic access would still need the user's permission. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
